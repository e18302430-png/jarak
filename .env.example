# قاعدة البيانات (Postgres). لو فاضية يشتغل على PGlite محلي في مجلد PGLITE_DIR
DATABASE_URL=
PGLITE_DIR=./data
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://jarak.example.com

# لوحة الإدارة: حط كلمة سر طويلة وعشوائية
ADMIN_TOKEN=
# ملح سري لتشفير رموز التحقق
OTP_PEPPER=

# الذكاء الاصطناعي (Gemini). بدون مفتاح يشتغل محلل بسيط بدون نت
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# الدفع (ميسّر). بدون مفتاح يشتغل وضع الدفع التجريبي
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# رسائل رمز الدخول (لازمة للإطلاق): taqnyat أو unifonic أو msegat
# dev للتطوير على جهازك بس: الرمز يطلع في سجل السيرفر
SMS_PROVIDER=taqnyat
TAQNYAT_TOKEN=
TAQNYAT_SENDER=
UNIFONIC_APPSID=
UNIFONIC_SENDER=
MSEGAT_USER=
MSEGAT_APIKEY=
MSEGAT_SENDER=

# الإشعارات (اختياري): لو فاضية ينولد مفتاح تلقائياً ويتحفظ في قاعدة البيانات
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=

# مكان صور المنتجات اللي تصوّرها البقالات. في الاستضافة لازم يكون على قرص دائم
# اختياري: نسخة من الصور على القرص كمان (الأساس إنها في قاعدة البيانات)
# UPLOADS_DIR=./public/img/u

# 0 = تشغيل حقيقي (الافتراضي). 1 = بقالات ومناديب وهميين للعرض على جهازك فقط
DEMO=0
